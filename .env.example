# Path to the local SQLite database file. Defaults to .domino/domino.db
# relative to the working directory.
DOMINO_DB_PATH=

# Absolute path to the Reasonix home directory that contains .env.
# Defaults to ~/.reasonix.
DOMINO_REASONIX_HOME=

# Reasonix executable used for provider discovery. Defaults to reasonix on PATH.
DOMINO_REASONIX_BIN=
